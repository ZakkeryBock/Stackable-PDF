{
  "name": "pdf-suite",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Convert, combine and edit PDFs — all offline on your device.",
  "author": "Stackable",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app:preview": "vite build && electron .",
    "app:dev": "cross-env ELECTRON_DEV=1 electron .",
    "app:dir": "vite build && electron-builder --dir",
    "app:pack": "vite build && node scripts/pack-win.mjs",
    "app:build": "node scripts/prepare-wincodesign.mjs && vite build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.stackable.pdftools",
    "productName": "Stackable PDF Tools",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "ZakkeryBock",
      "repo": "Stackable-PDF"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stackable PDF Tools"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
